<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTITO WIFI"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Desarrollado por Grupo 3 IoT"
            android:textAlignment="center"
            android:textColor="#666666"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:inputType="textUri"
            android:padding="12dp"
            android:text="192.168.4.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAbrirWifi"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="ABRIR WIFI" />

            <Button
                android:id="@+id/btnProbarConexion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="PROBAR CONEXIÓN" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Conecta a la red del auto"
            android:textAlignment="center"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/txtUltimaOrden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Orden: Detenido"
            android:textAlignment="center"
            android:textColor="#1976D2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVelocidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Velocidad 100 %"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekVelocidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:max="80"
            android:progress="80" />

        <!-- Cruceta de Movimiento -->
        <Button
            android:id="@+id/btnAvanzar"
            android:layout_width="100dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:text="▲"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIzquierda"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:layout_marginEnd="4dp"
                android:text="◄"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnDetener"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#D32F2F" />

            <Button
                android:id="@+id/btnDerecha"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:layout_marginStart="4dp"
                android:text="►"
                android:textSize="20sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRetroceder"
            android:layout_width="100dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:text="▼"
            android:textSize="20sp" />

        <!-- Acciones Secundarias -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCurvaIzquierda"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Curva Izq" />

            <Button
                android:id="@+id/btnCurvaDerecha"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Curva Der" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnProbarIzquierda"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Motor Izq" />

            <Button
                android:id="@+id/btnProbarDerecha"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Motor Der" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mantén pulsado para mover y suelta para detener"
            android:textAlignment="center"
            android:textColor="#666666"
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>
</ScrollView>